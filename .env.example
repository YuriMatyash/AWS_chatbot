# Frontend build/runtime variable (Amplify environment variable)
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.REGION.amazonaws.com

# Lambda environment variables
TABLE_NAME=ChatMessages
OPENAI_SECRET_NAME=openai/chatbot/api-key
OPENAI_MODEL=gpt-4.1-nano
ALLOWED_ORIGIN=*

# Note: Keep OpenAI API key only in AWS Secrets Manager, not in frontend or Lambda env plaintext.
